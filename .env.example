# Copy to .env and set these using your backend account.
MEDIA_CLOUD_API_KEY=replace-with-your-backend-api-key
SECRET_KEY=replace-with-a-random-session-secret
PAYLOAD_API_URL=https://your-existing-cms/api
PAYLOAD_API_KEY=replace-with-your-cms-api-key
# Local MongoDB and Redis run automatically. To use external stores, override:
# MONGO_URL=mongodb://user:password@mongo-host:27017/civicsignal?authSource=admin
# SESSION_REDIS_URL=redis://redis-host:6379/0
# CACHE_REDIS_URL=redis://redis-host:6379/1
# MEDIA_CLOUD_API_URL=https://backend-host/api/v2/
